COMPOSE_PROJECT_NAME=job-autopilot
APP_PORT=3400
# SQLite; relative paths resolve from server/
DATABASE_URL=file:./data/job-autopilot.db
PORT=3400
HOST=127.0.0.1
JWT_SECRET=replace-with-a-random-secret
APP_ORIGIN=http://localhost:3400
AUTH_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
JWT_TTL_SECONDS=3600
# Сокет брокера agent Chromium (сборщик и npm run browser:check); по умолчанию /run/agent-browser/broker.sock
AGENT_BROWSER_SOCKET=/run/agent-browser/broker.sock
# Локальная модель для оценки вакансий (Ollama HTTP API)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=120000
# Job-Tracker: профиль кандидата и список To Apply (AI API). Без обоих значений интеграция выключена.
# Токен создаётся в Job-Tracker командой `auth tokens create`; в Git его не добавлять.
JOB_TRACKER_URL=
JOB_TRACKER_TOKEN=
# Агент подачи (claude -p на DeepSeek + Playwright MCP)
# Предел одного запуска агента, мс (по умолчанию 10 минут)
APPLY_TIMEOUT_MS=600000
# Настройки claude для DeepSeek (env с ключом); файл не копировать в репозиторий
DEEPSEEK_SETTINGS=~/.config/deepseek/claude-settings.json
# Playwright MCP, к которому подключается агент
PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931/mcp
# Рабочая папка claude агента: settings, mcp.json и files/ с копиями /srv/agent-files для загрузки.
# Должна быть вне /home и читаться группой agent (сервис Playwright MCP: ProtectHome=yes)
AGENT_CWD=/srv/agent-files/agent-run
# Цены DeepSeek: USD за 1M токенов, см. страницу цен DeepSeek. Без них агент не запускается.
DEEPSEEK_PRICE_INPUT=
DEEPSEEK_PRICE_CACHE_READ=
DEEPSEEK_PRICE_OUTPUT=
# Подача (npm run apply, /run apply в боте, docs/applications.md): запусков агента за один прогон
APPLY_MAX_PER_RUN=5
# Предел затрат на агента в сутки (UTC), USD; считается по applications.costMicros
APPLY_MAX_USD_PER_DAY=0.5
# Имя файла резюме в /srv/agent-files (агент загружает его копию из AGENT_CWD/files/); пусто — единственный PDF там
APPLY_CV_FILE=
# Telegram-бот job-autopilot (npm run bot, docs/telegram.md): токен от @BotFather и свой chat id.
# Бот отвечает только этому чату; в Git значения не добавлять.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# От чьего имени работает бот (email); пусто — единственный активный пользователь
BOT_USER=
# Часовой пояс новых расписаний (по умолчанию Europe/Dublin)
SCHEDULE_TIMEZONE=
# Отчёт после планового запуска: changes — только при новых queued или ошибках (по умолчанию), always — всегда
BOT_SCHEDULED_REPORT=
