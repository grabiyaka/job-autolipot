{
  "name": "@jwx-framework/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "architecture": "tsx scripts/check-architecture.ts",
    "test": "vitest run",
    "check": "npm run domain:check && npm run typecheck && npm run architecture && npm test && npm run build",
    "domain:generate": "tsx scripts/generate-domains.ts",
    "domain:check": "tsx scripts/generate-domains.ts --check",
    "db:generate": "prisma generate && npm run domain:generate",
    "db:migrate": "prisma migrate deploy",
    "user:create": "node dist/scripts/create-user.js",
    "collect": "tsx scripts/collect.ts",
    "browser:check": "tsx scripts/browser-check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@prisma/dmmf": "7.10.0",
    "@prisma/internals": "7.10.0",
    "@types/node": "^22.19.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "mysql2": "^3.24.5"
  }
}
