generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// ───────────── Пользователи и сессии ─────────────

enum UserRole {
  admin
  user
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         UserRole      @default(user)
  disabled     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  sessions     AuthSession[]
  jobs         Job[]
  answers      Answer[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ───────────── Вакансии ─────────────

/// found → scored → rejected | queued → applying → applied | needs_input | failed | skipped
enum JobStatus {
  found
  scored
  rejected
  queued
  applying
  applied
  needs_input
  failed
  skipped
}

/// Найденная вакансия пользователя. URL канонизируется модулем источника и вместе с userId
/// служит ключом дедупликации: одну вакансию могут независимо найти разные пользователи.
model Job {
  id           String        @id @default(uuid())
  userId       String
  url          String
  /// Код модуля-источника: linkedin, djinni, indeed, …
  source       String
  /// ID вакансии на стороне источника, если он есть.
  externalId   String?
  company      String
  title        String
  location     String?
  description  String?
  /// Сырые данные карточки от модуля (JSON-строка), чтобы не терять поля, не вошедшие в схему.
  raw          String?
  score        Int?
  why          String?
  /// JSON-массив строк.
  redFlags     String?
  status       JobStatus     @default(found)
  postedAt     DateTime?
  foundAt      DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, url])
  @@unique([userId, source, externalId])
  @@index([userId, status])
  @@index([userId, company])
  @@map("jobs")
}

enum ApplicationStatus {
  running
  applied
  needs_input
  failed
  skipped
}

/// Одна попытка подачи на вакансию.
model Application {
  id               String            @id @default(uuid())
  jobId            String
  status           ApplicationStatus @default(running)
  /// Сессия агента (DeepSeek) для `--resume`.
  sessionId        String?
  screenshotBefore String?
  screenshotAfter  String?
  /// Итоговый JSON агента.
  result           String?
  inputTokens      Int               @default(0)
  outputTokens     Int               @default(0)
  /// Стоимость в микродолларах (1e-6 USD), чтобы не хранить float.
  costMicros       Int               @default(0)
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questions        Question[]

  @@index([jobId])
  @@index([status])
  @@map("applications")
}

/// open → answered → used
enum QuestionStatus {
  open
  answered
  used
}

/// Вопрос агента по конкретной подаче.
model Question {
  id                String         @id @default(uuid())
  applicationId     String
  text              String
  answer            String?
  status            QuestionStatus @default(open)
  telegramMessageId String?
  createdAt         DateTime       @default(now())
  answeredAt        DateTime?
  application       Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
  @@map("questions")
}

enum AnswerOrigin {
  manual
  telegram
}

/// Банк ответов пользователя: вопрос → ответ, переиспользуется во всех его подачах.
model Answer {
  id        String       @id @default(uuid())
  userId    String
  /// Нормализованная формулировка вопроса (ключ поиска в пределах пользователя).
  key       String
  question  String
  answer    String
  origin    AnswerOrigin @default(manual)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("answers")
}
