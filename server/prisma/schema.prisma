generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// ───────────── Пользователи и сессии ─────────────

enum UserRole {
  admin
  user
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           UserRole        @default(user)
  disabled       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  sessions       AuthSession[]
  jobs           Job[]
  searches       Search[]
  answers        Answer[]
  schedules      Schedule[]
  taskRuns       TaskRun[]
  trackerProfile TrackerProfile?

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ───────────── Вакансии ─────────────

/// found → scored → rejected | queued → applying → applied | needs_input | failed | skipped | manual;
/// manual — подать может только сам пользователь (аккаунт, капча, Workday…), затем «✅ подал сам» → applied.
enum JobStatus {
  found
  scored
  rejected
  queued
  applying
  applied
  needs_input
  failed
  skipped
  manual
}

/// Найденная вакансия пользователя. URL канонизируется модулем источника и вместе с userId
/// служит ключом дедупликации: одну вакансию могут независимо найти разные пользователи.
model Job {
  id              String        @id @default(uuid())
  userId          String
  url             String
  /// Код модуля-источника: linkedin, djinni, indeed, …
  source          String
  /// ID вакансии на стороне источника, если он есть.
  externalId      String?
  company         String
  title           String
  location        String?
  description     String?
  /// Сырые данные карточки от модуля (JSON-строка), чтобы не терять поля, не вошедшие в схему.
  raw             String?
  score           Int?
  why             String?
  /// JSON-массив строк.
  redFlags        String?
  status          JobStatus     @default(found)
  /// ID JobOpportunity в Job-Tracker; null — вакансия ещё не отправлена.
  trackerId       String?
  /// Ревизия профиля Job-Tracker, по которой выставлена оценка.
  profileRevision Int?
  postedAt        DateTime?
  foundAt         DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    Application[]

  @@unique([userId, url])
  @@unique([userId, source, externalId])
  @@index([userId, status])
  @@index([userId, company])
  @@map("jobs")
}

// ───────────── Job-Tracker (этап «Отбор») ─────────────

/// Кэш профиля пользователя из Job-Tracker, по которому scorer оценивает вакансии.
model TrackerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  revision  Int
  etag      String?
  markdown  String
  fetchedAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tracker_profiles")
}

// ───────────── Поиски (этап «Сбор») ─────────────

/// Сохранённый поиск пользователя на одном источнике. Сборщик прогоняет все включённые поиски.
model Search {
  id            String      @id @default(uuid())
  userId        String
  /// Код модуля-источника из реестра `src/searches/SearchSources.ts`.
  source        String
  keywords      String
  location      String?
  /// JSON-массив слов: в названии вакансии должно быть хотя бы одно (пусто — без ограничения).
  includeTitle  String?
  /// JSON-массив слов: вакансия с любым из них в названии отсеивается до открытия её страницы.
  excludeTitle  String?
  /// Только вакансии с LinkedIn Easy Apply (фильтр `f_AL=true` в адресе выдачи).
  easyApplyOnly Boolean     @default(false)
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs          SearchRun[]

  @@index([userId])
  @@map("searches")
}

/// Почему прогон поиска остановился.
enum SearchStopReason {
  end
  known
  limit
  aborted
  error
}

/// Отчёт одного прогона сохранённого поиска. Пробные прогоны (dry-run) не записываются.
model SearchRun {
  id         String           @id @default(uuid())
  searchId   String
  startedAt  DateTime
  finishedAt DateTime
  pages      Int
  /// Карточки в выдаче без повторов внутри прогона.
  seen       Int
  /// Карточки, которых у владельца ещё не было.
  fresh      Int
  /// Новые карточки, отсеянные фильтром по названию (сохранены как rejected).
  filtered   Int              @default(0)
  created    Int
  duplicates Int
  invalid    Int
  stopped    SearchStopReason
  error      String?
  search     Search           @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId, startedAt])
  @@map("search_runs")
}

/// running → ready (ждёт ✅) → submitted (отправлено, JT ещё не отмечен) → applied;
/// running → needs_input | failed | skipped | manual; ready → skipped (❌) | failed | needs_input | manual;
/// manual → submitted («✅ подал сам») | skipped (❌).
enum ApplicationStatus {
  running
  ready
  submitted
  applied
  needs_input
  failed
  skipped
  manual
}

/// Где форма: диалог LinkedIn Easy Apply или сайт компании / ATS.
enum ApplicationKind {
  easy_apply
  external
}

/// Одна попытка подачи на вакансию.
model Application {
  id               String            @id @default(uuid())
  jobId            String
  status           ApplicationStatus @default(running)
  kind             ApplicationKind   @default(easy_apply)
  /// Страница формы, на которой агент остановился (для external — откуда начинает submit_fresh, для manual — ссылка пользователю).
  applyUrl         String?
  /// `channel` отметки в Job-Tracker: linkedin_easy_apply | company_site | company_site_manual; задаётся при отправке.
  trackerChannel   String?
  /// Сессия агента (DeepSeek) для `--resume`.
  sessionId        String?
  screenshotBefore String?
  screenshotAfter  String?
  /// Итоговый JSON агента.
  result           String?
  /// Понятная причина итога (внешняя подача, отказ, ответ Job-Tracker…).
  note             String?
  inputTokens      Int               @default(0)
  /// Входные токены из кеша DeepSeek (дешевле обычных).
  cacheReadTokens  Int               @default(0)
  outputTokens     Int               @default(0)
  /// Стоимость в микродолларах (1e-6 USD), чтобы не хранить float.
  costMicros       Int               @default(0)
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questions        Question[]

  @@index([jobId])
  @@index([status])
  @@map("applications")
}

/// open → answered → used
enum QuestionStatus {
  open
  answered
  used
}

/// Вопрос агента по конкретной подаче.
model Question {
  id                String         @id @default(uuid())
  applicationId     String
  text              String
  answer            String?
  status            QuestionStatus @default(open)
  telegramMessageId String?
  createdAt         DateTime       @default(now())
  answeredAt        DateTime?
  application       Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
  @@index([telegramMessageId])
  @@map("questions")
}

enum AnswerOrigin {
  manual
  telegram
}

/// Банк ответов пользователя: вопрос → ответ, переиспользуется во всех его подачах.
model Answer {
  id        String       @id @default(uuid())
  userId    String
  /// Нормализованная формулировка вопроса (ключ поиска в пределах пользователя).
  key       String
  question  String
  answer    String
  origin    AnswerOrigin @default(manual)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("answers")
}

// ───────────── Расписание и запуски задач (Telegram-бот) ─────────────

/// Задача конвейера, которую можно запустить из бота или по расписанию.
enum PipelineTask {
  collect
  score
  cycle
  apply
}

enum TaskTrigger {
  manual
  schedule
}

/// running → ok | error | aborted; busy — запуск не начался: занято другой задачей или браузер занят.
enum TaskRunStatus {
  running
  ok
  error
  aborted
  busy
}

/// Расписание задачи пользователя: одно на задачу. Новое создаётся выключенным.
model Schedule {
  id          String         @id @default(uuid())
  userId      String
  task        PipelineTask
  /// Выражение cron из 5 полей, например `0 9,18 * * *`.
  cron        String
  /// Часовой пояс IANA, в котором читается cron.
  timezone    String         @default("Europe/Dublin")
  enabled     Boolean        @default(false)
  /// JSON флагов задачи: limit, threshold, maxMinutes, easyApply, skipCollect.
  options     String?
  lastRunAt   DateTime?
  lastStatus  TaskRunStatus?
  lastSummary String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        TaskRun[]

  @@unique([userId, task])
  @@map("schedules")
}

/// Один ручной или плановый запуск задачи и его итог.
model TaskRun {
  id         String        @id @default(uuid())
  userId     String
  task       PipelineTask
  trigger    TaskTrigger
  scheduleId String?
  startedAt  DateTime
  finishedAt DateTime?
  status     TaskRunStatus
  summary    String?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule   Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([status])
  @@map("task_runs")
}
